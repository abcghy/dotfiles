#---- monitors
output "ViewSonic Corporation VX2780-4K-hd VP9190800933" {
    scale 2
    pos 0 0
}

output "eDP-1" {
    pos 240 1080
}

bindswitch --reload --locked lid:on output $laptop disable
bindswitch --reload --locked lid:off output $laptop enable

#---- wallpapers
# output "*" bg ~/Pictures/wallpapers/bg1.jpg fill


#---- gaps
gaps inner 8
# gaps inner all set 8
# gaps outer 0
# smart_gaps on

client.focused #FF0000 #FF9900 #000000
client.focused_inactive #333333 #5f676a #000000
client.unfocused #333333 #222222 #ffffff

#---- input
#---- mouse
floating_modifier $mod normal

input type:pointer {
    natural_scroll enabled
    accel_profile "flat"
    scroll_factor 0.5
}

focus_follows_mouse no

input type:touchpad {
    natural_scroll enabled

    scroll_factor 0.15
    tap enabled
}

bindgesture swipe:right workspace prev_on_output
bindgesture swipe:left workspace next_on_output


#---- borders
default_border pixel



#---- windows rule
for_window {
    # pinentry qt needs to be float and above all workspaces
    [app_id="org.gnupg.pinentry-qt"] floating enable
    [app_id="org.gnupg.pinentry-qt"] sticky enable
}
